{
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_WITH_PRODUCTION_SQL_CONNECTION_STRING"
  },
  "JwtSettings": {
    "Issuer": "REPLACE_WITH_YOUR_ISSUER",
    "Audience": "REPLACE_WITH_YOUR_AUDIENCE",
    "SecretKey": "REPLACE_WITH_MIN_64CHARS_CRYPTIC_SECRET_FROM_USER_SECRETS_OR_AZURE_KEY_VAULT",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 14
  },
  "EmailSettings": {
    "SmtpHost": "REPLACE_WITH_SMTP_HOST",
    "SmtpPort": 587,
    "EnableSsl": true,
    "SmtpUserName": "REPLACE_WITH_SMTP_USER",
    "SmtpPassword": "REPLACE_WITH_SMTP_PASS_OR_USE_APP_PASSWORD",
    "FromName": "NetCoreTemplate",
    "FromEmail": "noreply@yourdomain.com",
    "AppBaseUrl": "https://yourdomain.com"
  },
  "LockoutSettings": {
    "MaxFailedAccessAttempts": 5,
    "DefaultLockoutMinutes": 30,
    "AllowLockout": true
  },
  "PasswordSettings": {
    "RequiredLength": 10,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true,
    "RequiredUniqueChars": 3
  },
  "CorsSettings": {
    "AllowedOrigins": [ "https://yourdomain.com", "https://www.yourdomain.com" ]
  },
  "RateLimiting": {
    "AuthFixedWindow": {
      "PermitLimit": 6,
      "WindowMinutes": 10,
      "QueueLimit": 0
    },
    "PerUserSlidingWindow": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "GlobalIpSlidingWindow": {
      "PermitLimit": 300,
      "WindowMinutes": 15,
      "QueueLimit": 0
    }
  },
  "HealthChecks": {
    "EnableDetailed": false,
    "TimeoutSeconds": 15
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "REPLACE_WITH_OTLP_GRPC_ENDPOINT",
    "EnableTracing": true,
    "EnableMetrics": true
  },
  "FileStorage": {
    "Provider": "Azure",
    "LocalPath": "wwwroot/uploads",
    "AppBaseUrl": "https://yourdomain.com",
    "AzureBlob": {
      "ConnectionString": "REPLACE_WITH_AZURE_BLOB_CONNECTION_STRING_OR_USE_MANAGED_IDENTITY",
      "ContainerName": "uploads"
    }
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardTitle": "NetCoreTemplate Hangfire Dashboard",
    "SchemaName": "Hangfire",
    "WorkerCount": 16,
    "Queues": [ "default", "email", "notification", "recurring" ]
  },
  "NotificationSettings": {
    "SignalRMessageTtl": 86400
  },
  "Idempotency": {
    "SlidingExpirationMinutes": 120
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.Authentication": "Information"
      }
    }
  },
  "AllowedHosts": "yourdomain.com;www.yourdomain.com"
}
