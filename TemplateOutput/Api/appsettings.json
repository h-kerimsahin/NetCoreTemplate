{
  "ConnectionStrings": {
    "DefaultConnection": "$wizard_connectionstring$"
  },
  "JwtSettings": {
    "Issuer": "$safeprojectname$",
    "Audience": "$safeprojectname$.Users",
    "SecretKey": "$wizard_jwtsecret$",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 14
  },
  "EmailSettings": {
    "SmtpHost": "localhost",
    "SmtpPort": 25,
    "EnableSsl": false,
    "SmtpUserName": "",
    "SmtpPassword": "",
    "FromName": "$safeprojectname$",
    "FromEmail": "noreply@$safeprojectname$.local",
    "AppBaseUrl": "https://localhost:7000"
  },
  "LockoutSettings": {
    "MaxFailedAccessAttempts": 5,
    "DefaultLockoutMinutes": 15,
    "AllowLockout": true
  },
  "PasswordSettings": {
    "RequiredLength": 8,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true,
    "RequiredUniqueChars": 1
  },
  "CorsSettings": {
    "AllowedOrigins": [ "" ]
  },
  "RateLimiting": {
    "AuthFixedWindow": {
      "PermitLimit": 10,
      "WindowMinutes": 10,
      "QueueLimit": 0
    },
    "PerUserSlidingWindow": {
      "PermitLimit": 150,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "GlobalIpSlidingWindow": {
      "PermitLimit": 500,
      "WindowMinutes": 15,
      "QueueLimit": 0
    }
  },
  "HealthChecks": {
    "EnableDetailed": true,
    "TimeoutSeconds": 30
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "EnableTracing": true,
    "EnableMetrics": true
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalPath": "wwwroot/uploads",
    "AppBaseUrl": "https://localhost:7000",
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": ""
    }
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardTitle": "$safeprojectname$ Hangfire Dashboard",
    "SchemaName": "Hangfire",
    "WorkerCount": 0,
    "Queues": [ "default", "email", "notification", "recurring" ]
  },
  "NotificationSettings": {
    "SignalRMessageTtl": 86400
  },
  "ApiVersioning": {
    "DefaultVersion": "1.0",
    "AssumeDefaultVersion": true,
    "ReportApiVersions": true
  },
  "OData": {
    "MaxTop": 100,
    "EnableNoDollarSign": true,
    "EnableExpand": true,
    "MaxExpansionDepth": 3,
    "EnableFilter": true,
    "EnableOrderBy": true,
    "EnableSelect": true,
    "EnableCount": true
  },
  "Idempotency": {
    "SlidingExpirationMinutes": 120
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
