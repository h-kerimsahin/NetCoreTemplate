      <ProjectItem ReplaceParameters="true" TargetFileName="Hubs\NotificationHub.cs">Hubs\NotificationHub.cs</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Idempotency\IdempotencyEndpointFilter.cs">Idempotency\IdempotencyEndpointFilter.cs</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Middlewares\CorsSettings.cs">Middlewares\CorsSettings.cs</ProjectItem>
