      <ProjectItem ReplaceParameters="true" TargetFileName="Endpoints\RolesEndpoints.cs">Endpoints\RolesEndpoints.cs</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Endpoints\SoftRestoreEndpoints.cs">Endpoints\SoftRestoreEndpoints.cs</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Endpoints\SystemLogsEndpoints.cs">Endpoints\SystemLogsEndpoints.cs</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Endpoints\UserManagementEndpoints.cs">Endpoints\UserManagementEndpoints.cs</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Endpoints\UserProfileEndpoints.cs">Endpoints\UserProfileEndpoints.cs</ProjectItem>
